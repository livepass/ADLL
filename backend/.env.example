# ADLL 后端环境配置模板（本文件仅为示例；不包含任何真实凭据）
# 存储/凭据/AI 端点均经环境注入；复制为 .env 并由运行环境提供实际值。

ADLL_APP_NAME=ADLL
ADLL_DATABASE_URL=sqlite:///./data/adll.db
ADLL_CORS_ORIGINS=http://localhost:5173
ADLL_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# 批 8 受限 worker（默认关闭；真实 AI 仍需单独批准）
# 所有路径由运行环境注入；ACL 仅允许在 ACL_ROOT 之内修改。
ADLL_WORKER_SANDBOX_ROOT=
ADLL_WORKER_ACL_ROOT=
ADLL_WORKER_DENY_READ=
ADLL_WORKER_DENY_WRITE=
ADLL_WORKER_PYTHON=
ADLL_WORKER_REAL_TRANSPORT=0